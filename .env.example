# Every variable the app reads, grouped by concern, with a safe local default.
# Validated at boot by src/config/env.validation.ts: a bad or missing value stops the process
# with a readable list of problems. Optional integrations left empty are simply switched off
# (their routes answer "not set up yet"), never a boot failure.
# Which process needs what: docs/architecture/processes.md.

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=nest-boilerplate
# Git SHA or version; tags logs, Sentry events and traces.
RELEASE=
API_PORT=3000
SOCKET_PORT=3001
GRAPHQL_PORT=3002
GRPC_PORT=50051
API_PREFIX=api
API_DEFAULT_VERSION=1
# Proxy hops in front of the app (one load balancer = 1). Needed for real client IPs.
TRUST_PROXY=1
# Comma-separated browser origins allowed by CORS (empty = no browser access).
CORS_ORIGINS=http://localhost:5173
BODY_LIMIT=1mb
# Serves /api/docs. Keep false in production.
SWAGGER_ENABLED=true
# Web app base URL, used in links sent by e-mail.
APP_WEB_URL=http://localhost:5173

# ── Time (docs/conventions/time.md) ─────────────────────────────────────────
# IANA zone the "day a record belongs to" is computed in. Never an offset like +04:00.
BUSINESS_TIMEZONE=UTC
WEEK_STARTS_ON=monday

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ── MongoDB (must be a replica set: transactions) ───────────────────────────
MONGO_URI=mongodb://localhost:27047/app?directConnection=true
# true in dev; false in production (indexes applied with `pnpm db:sync-indexes --apply`).
MONGO_AUTO_INDEX=true
MONGO_MAX_POOL_SIZE=50

# ── Redis ───────────────────────────────────────────────────────────────────
# Core instance (maxmemory-policy noeviction): queues, locks, sessions, OTP, rate limits, pub/sub.
REDIS_URL=redis://localhost:6389
# Cache instance (allkeys-lru). Optional: empty = no cache, the app only gets slower.
REDIS_CACHE_URL=redis://localhost:6390
REDIS_KEY_PREFIX=app:
CACHE_DEFAULT_TTL_SECONDS=300

# ── Auth: tokens and sessions (generate secrets with: openssl rand -base64 48) ─
# Local-only placeholders: replace both before deploying anywhere.
JWT_ACCESS_SECRET=local-access-secret-change-me-0123456789abcdef
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-refresh-secret-change-me-0123456789abcdef
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=nest-boilerplate
JWT_AUDIENCE=nest-boilerplate
# Accepted clock difference between servers when checking token expiry.
JWT_CLOCK_TOLERANCE_SECONDS=5
AUTH_MAX_SESSIONS_PER_USER=10
# Failed password sign-ins before the account is locked for AUTH_LOCKOUT_SECONDS.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
# Days between an account deletion request and the deletion (signing in cancels it).
USER_DELETION_GRACE_DAYS=30
# Machine clients: name=<sha256 hex of the key>, comma separated (empty = no API keys).
# Hash a key with: printf '%s' "$KEY" | sha256sum
API_KEYS=

# ── OTP (one-time codes by SMS or e-mail) ───────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFIES_PER_HOUR=15
# Log codes instead of sending them (local sign-in without a phone). Refused in production.
OTP_DEV_LOG=true

# ── Rate limiting (per user when signed in, else per IP) ────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
# Per minute on sign-in / sign-up routes, and on routes that send a code.
THROTTLE_AUTH_LIMIT=10
THROTTLE_OTP_LIMIT=5
# How long a response to an Idempotency-Key request is replayed.
IDEMPOTENCY_TTL_SECONDS=86400

# ── Socket.IO ───────────────────────────────────────────────────────────────
SOCKET_PATH=/socket.io
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
SOCKET_MAX_BUFFER_BYTES=100000
SOCKET_COMPRESSION_THRESHOLD_BYTES=1024
SOCKET_EVENTS_PER_WINDOW=30
SOCKET_EVENT_WINDOW_MS=10000

# ── GraphQL ─────────────────────────────────────────────────────────────────
GRAPHQL_PATH=/graphql
# Empty = on outside production, off in production.
GRAPHQL_INTROSPECTION=
GRAPHQL_MAX_DEPTH=8
GRAPHQL_MAX_COMPLEXITY=1000

# ── Observability ───────────────────────────────────────────────────────────
# Empty = Sentry disabled.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# One switch for OpenTelemetry traces and metrics (OTLP over HTTP).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# Empty = <APP_NAME>-<process>, e.g. nest-boilerplate-api.
OTEL_SERVICE_NAME=

# ── Audit trail ─────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=90

# ── File storage: S3 (empty bucket = uploads not set up) ────────────────────
AWS_REGION=us-east-1
# Empty keys = the default AWS credential chain (IAM role in production).
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
S3_BUCKET=app-local
# Local S3 (docker compose SeaweedFS). Empty in production on AWS.
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
# CDN or bucket URL for public files (empty = presigned download URLs only).
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=900
S3_MAX_UPLOAD_BYTES=10485760

# ── E-mail: SMTP (empty host = e-mail not set up) ───────────────────────────
# Local: docker compose Mailpit, inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nest Boilerplate <no-reply@example.com>

# ── SMS: Twilio (empty SID = SMS not set up) ────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: an E.164 number or a Messaging Service SID (MG…).
TWILIO_FROM=

# ── Push: Firebase Cloud Messaging (both empty = push not set up) ───────────
# The service-account JSON (raw or base64), or a path to it. Never commit the key file.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_CREDENTIALS_FILE=

# ── Payments: Stripe (empty key = payments not set up) ──────────────────────
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the dashboard endpoint in production.
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing

# ── Notifications ───────────────────────────────────────────────────────────
NOTIFICATIONS_INBOX_RETENTION_DAYS=90

# ── Domain events and inter-service transport (docs/architecture/microservices.md) ─
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
# none | rabbitmq: also publish domain events to the RabbitMQ topic exchange.
EVENTS_EXTERNAL=none
# Ports called over the wire, e.g. examples=grpc (empty = everything in-process).
TRANSPORT_ROUTES=
# docker compose --profile transport up -d rabbitmq
RABBITMQ_URL=
RABBITMQ_EXCHANGE=app.events
RABBITMQ_PREFETCH=20
GRPC_EXAMPLES_URL=localhost:50051
GRPC_DEADLINE_MS=3000

# ── Resilience: outbound integrations (safe defaults) ───────────────────────
# Circuit breaker per process and integration: opens after N consecutive transient failures,
# fails fast for the open period, then lets one probe call through.
INTEGRATION_BREAKER_ENABLED=true
INTEGRATION_BREAKER_FAILURE_THRESHOLD=5
INTEGRATION_BREAKER_OPEN_SECONDS=30
# Per integration (s3, smtp, twilio, fcm, stripe): threshold/open seconds, e.g. fcm=10/60
INTEGRATION_BREAKER_OVERRIDES=
INTEGRATION_HTTP_TIMEOUT_MS=10000
FCM_TIMEOUT_MS=30000
SMTP_TIMEOUT_MS=20000
S3_TIMEOUT_MS=30000
TWILIO_TIMEOUT_MS=15000
STRIPE_TIMEOUT_MS=20000

# ── Runtime fault tolerance (docs/architecture/fault-tolerance.md) ──────────
# Graceful shutdown deadline; keep it below the platform kill timeout (30 s).
SHUTDOWN_TIMEOUT_MS=25000
# Readiness answers 503 this long before the HTTP listener closes (0 = close at once).
SHUTDOWN_DRAIN_DELAY_MS=0
REQUEST_TIMEOUT_MS=30000
REQUEST_TIMEOUT_UPLOAD_MS=120000
# Above the load balancer idle timeout (AWS ALB 60 s).
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_TRANSACTION_MAX_ATTEMPTS=20
MONGO_TRANSACTION_RETRY_WINDOW_MS=10000
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_MAX_RETRIES_PER_REQUEST=2
REDIS_CACHE_COMMAND_TIMEOUT_MS=500
