{
  "name": "nest-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready NestJS boilerplate: one codebase, five processes (api, graphql, socket, worker, cron).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\" \"*.{json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "dev:api": "nest start --watch --entryFile main.api",
    "dev:graphql": "nest start --watch --entryFile main.graphql",
    "dev:socket": "nest start --watch --entryFile main.socket",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "dev:cron": "nest start --watch --entryFile main.cron",
    "dev:grpc": "nest start --watch --entryFile main.grpc",
    "start:api": "node --enable-source-maps dist/main.api.js",
    "start:graphql": "node --enable-source-maps dist/main.graphql.js",
    "start:socket": "node --enable-source-maps dist/main.socket.js",
    "start:worker": "node --enable-source-maps dist/main.worker.js",
    "start:cron": "node --enable-source-maps dist/main.cron.js",
    "start:grpc": "node --enable-source-maps dist/main.grpc.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config test/jest-e2e.config.js --maxWorkers=3 --workerIdleMemoryLimit=1500MB",
    "test:tz": "for tz in UTC Asia/Dubai America/Los_Angeles Pacific/Kiritimati; do echo \"== server TZ=$tz\"; TZ=$tz NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --silent || exit 1; done",
    "test:tz:e2e": "for tz in Asia/Dubai Pacific/Kiritimati; do echo \"== server TZ=$tz\"; TZ=$tz NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config test/jest-e2e.config.js --maxWorkers=3 --workerIdleMemoryLimit=1500MB --silent || exit 1; done",
    "test:smoke": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config test/jest-smoke.config.js --runInBand",
    "test:load": "k6 run test/load/baseline.k6.js",
    "infra:up": "docker compose up -d --wait mongo redis-core redis-cache mailpit s3 rabbitmq && docker compose up -d s3-init",
    "infra:down": "docker compose down",
    "migrate": "nest build && node --enable-source-maps dist/cli/migrate.js",
    "migrate:dist": "node --enable-source-maps dist/cli/migrate.js",
    "db:sync-indexes": "nest build && node --enable-source-maps dist/cli/sync-indexes.js",
    "seed": "nest build && node --enable-source-maps dist/cli/seed.js",
    "admin:create": "nest build && node --enable-source-maps dist/cli/create-super-admin.js",
    "dev:token": "nest build && node --enable-source-maps dist/cli/dev-token.js",
    "openapi:export": "nest build && node --enable-source-maps dist/cli/openapi-export.js",
    "messages:export": "nest build && node --enable-source-maps dist/cli/messages-export.js",
    "graphql:schema": "nest build && node --enable-source-maps dist/cli/graphql-schema.js",
    "proto:gen": "buf generate && prettier --write src/infra/transport/grpc/generated",
    "g:module": "node scripts/generate-module.mjs",
    "prepare": "husky || true",
    "proto:lint": "buf lint"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/microservices": "12.1.3",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/platform-socket.io": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.1.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@sentry/nestjs": "11.7.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.2.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.13",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "dataloader": "2.2.3",
    "express": "5.2.1",
    "firebase-admin": "14.5.0",
    "graphql": "16.14.2",
    "graphql-query-complexity": "2.0.0",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "6.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "joi": "18.2.9",
    "luxon": "3.7.2",
    "mongoose": "9.11.2",
    "mongoose-aggregate-paginate-v2": "1.1.5",
    "mongoose-paginate-v2": "1.9.5",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "stripe": "23.0.0",
    "twilio": "6.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-proto": "2.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
